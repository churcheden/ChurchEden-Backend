generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum LoginProvider {
  EMAIL
  GOOGLE
}

enum Gender {
  MALE
  FEMALE
  PREFER_NOT_TO_SAY
}

enum MaritalStatus {
  SINGLE
  MARRIED
  DIVORCED
  WIDOWED
  PREFER_NOT_TO_SAY
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELED
  TRIALING
}

enum ChurchRole {
  MEMBER
  ADMIN
  SUPER_ADMIN
}

enum MembershipStatus {
  PENDING
  APPROVED
  REJECTED
}

enum CongregationSize {
  RANGE_1_100
  RANGE_101_500
  RANGE_501_1000
  RANGE_1001_2000
  RANGE_2000_PLUS
}

enum ChurchLanguage {
  ENGLISH
  FRENCH
  SPANISH
}

enum ChurchPlan {
  EXPLORER
  PLUS
  CORE
}

model SuperAdmin {
  id       String  @id @default(uuid())
  email    String  @unique
  password String? // optional: Google-login users never set one

  fullName String?

  googleId      String?       @unique
  loginProvider LoginProvider @default(EMAIL)
  isVerified    Boolean       @default(false)

  // store hashed values, never the raw token
  resetTokenHash    String?
  resetTokenExpires DateTime?

  lastLogin DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  church        Church?
  refreshTokens SuperAdminRefreshToken[]
  transactions  ChurchTransaction[]

  @@map("SuperAdmins")
}

model Church {
  id           String     @id @default(uuid())
  superAdminId String     @unique
  superAdmin   SuperAdmin @relation(fields: [superAdminId], references: [id], onDelete: Cascade)
  name         String
  denomination     String // free text — accepts preset or custom value identically
  congregationSize CongregationSize
  foundedYear      Int?

  country         String
  city            String
  address         String
  phone           String // E.164, e.g. +233241234567
  email           String
  primaryLanguage ChurchLanguage
  timeZone        String // IANA tz string, e.g. "Africa/Accra"

  logoUrl String? // R2 object URL
  plan                   ChurchPlan @default(EXPLORER)
  planStartedAt          DateTime?
  planExpiresAt          DateTime?
  subscriptionProcessor  String?  // "stripe" | "paypal"
  subscriptionRef        String?
  subscriptionStatus     SubscriptionStatus?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members      Member[]
  serviceTimes ServiceTime[]
  ministries   ChurchMinistry[]

  @@map("Churches")
}

model ServiceTime {
  id        String   @id @default(uuid())
  churchId  String
  church    Church   @relation(fields: [churchId], references: [id], onDelete: Cascade)
  label     String // "Sunday Service", "Midweek Service"
  dayOfWeek Int // 0 (Sunday) – 6 (Saturday)
  time      String // "HH:MM" 24h format — timezone context comes from Church.timeZone
  createdAt DateTime @default(now())

  @@index([churchId])
  @@map("ServiceTimes")
}

model ChurchMinistry {
  id          String  @id @default(uuid())
  churchId    String
  church      Church  @relation(fields: [churchId], references: [id], onDelete: Cascade)
  name        String
  type        String // "MINISTRY" | "DEPARTMENT"
  description String?
  icon        String?
  isCustom    Boolean @default(false)
  isActive    Boolean @default(true)

  @@unique([churchId, name]) // case-sensitive uniqueness per church; case-insensitive enforced at the app layer
  @@map("ChurchMinistries")
}

model Member {
  id       String  @id @default(uuid())
  email    String  @unique
  password String? // optional: Google-login users never set one
  googleId   String?        @unique
  isVerified Boolean        @default(false) // Checks phone number verification
  role       ChurchRole     @default(MEMBER) // A member can be elevated to an Admin rank by only the Super Admin

  churchId String?
  church   Church? @relation(fields: [churchId], references: [id], onDelete: Cascade)

  status          MembershipStatus @default(PENDING) // PENDING | APPROVED | REJECTED — matches the "Pending Approval" onboarding flow
  rejectionReason String? // set when an admin rejects a join request
  joinedAt        DateTime         @default(now()) // also serves as the join-request submission timestamp

  // Manual admin ban: a user banned from a church can no longer submit join requests.
  isBanned  Boolean   @default(false)
  bannedAt  DateTime?
  banReason String?

  memberProfile   MemberProfile?
  refreshTokens   MemberRefreshToken[]
  churchRequests  ChurchRequest[]

  @@index([churchId])
  @@map("Members")
}

model MemberProfile {
  id       String @id @default(uuid())
  memberId String @unique
  member   Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  profilePhotoUrl String? // R2 object URL, optional
  fullName        String // duplicates User.fullName intentionally — edited independently of the Google-sourced value
  dateOfBirth     DateTime
  gender          Gender
  phoneNumber     String // E.164 format, e.g. +233241234567
  contactEmail    String // email used to create account will be used as contact email for users
  city            String
  address         String
  maritalStatus   MaritalStatus
  occupation      String?
  ministry        String?
  deparment       String?

  completedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("MemberProfiles")
}

model SuperAdminRefreshToken {
  id           String     @id @default(uuid())
  superAdminId String
  superAdmin   SuperAdmin @relation(fields: [superAdminId], references: [id], onDelete: Cascade)
  tokenHash    String     @unique
  deviceInfo   String?
  expiresAt    DateTime
  revokedAt    DateTime?
  createdAt    DateTime   @default(now())

  @@index([superAdminId])
  @@map("SuperAdminRefreshTokens")
}

model MemberRefreshToken {
  id         String    @id @default(uuid())
  memberId   String
  member     Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  deviceInfo String?
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([memberId])
  @@map("MemberRefreshTokens")
}

model ChurchRequest {
  id            String   @id @default(uuid())
  churchName    String
  city          String
  leaderName    String
  phoneContact  String?
  emailContact  String?
  requestedById String
  requestedBy   Member   @relation(fields: [requestedById], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())

  @@index([requestedById])
  @@map("ChurchRequests")
}

model ChurchTransaction {
  id               String     @id @default(uuid())
  superAdminId     String
  superAdmin       SuperAdmin @relation(fields: [superAdminId], references: [id], onDelete: Cascade)
  reference        String     @unique
  amount           Decimal
  status           String
  authorizationUrl String
  createdAt        DateTime   @default(now())

  @@index([superAdminId])
  @@index([reference])
  @@map("ChurchTransactions")
}