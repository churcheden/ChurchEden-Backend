generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum LoginProvider {
  EMAIL
  GOOGLE
}

enum Gender {
  MALE
  FEMALE
  PREFER_NOT_TO_SAY
}

enum MaritalStatus {
  SINGLE
  MARRIED
  DIVORCED
  WIDOWED
  PREFER_NOT_TO_SAY
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELED
  TRIALING
}

enum ChurchRole {
  MEMBER
  ADMIN
  SUPER_ADMIN
}

enum MembershipStatus {
  PENDING
  APPROVED
  REJECTED
}

enum CongregationSize {
  RANGE_1_100
  RANGE_101_500
  RANGE_501_1000
  RANGE_1001_2000
  RANGE_2000_PLUS
}

enum ChurchLanguage {
  ENGLISH
  FRENCH
  SPANISH
}

model User {
  id       String  @id @default(uuid())
  email    String  @unique
  password String? // optional: Google-login users never set one

  fullName String?

  googleId      String?       @unique
  loginProvider LoginProvider @default(EMAIL)
  isVerified    Boolean       @default(false)

  // store hashed values, never the raw token
  resetTokenHash    String?
  resetTokenExpires DateTime?

  lastLogin DateTime?

  isPremium     Boolean   @default(false)
  premiumSince  DateTime?
  premiumExpiry DateTime?

  // processor-agnostic — was Paystack-specific
  subscriptionProcessor String? // e.g. "stripe" | "paypal" | "moolre"
  subscriptionRef       String? // that processor's subscription/customer id
  subscriptionStatus    SubscriptionStatus?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberProfile     MemberProfile?
  transactions      Transaction[]
  refreshTokens     RefreshToken[]
  churchMemberships ChurchMembership[]
  churchRequests    ChurchRequest[]

  @@index([isPremium])
  @@map("Users")
}

model MemberProfile {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  profilePhotoUrl String? // R2 object URL, optional
  fullName        String // duplicates User.fullName intentionally — edited independently of the Google-sourced value
  dateOfBirth     DateTime
  gender          Gender
  phoneNumber     String // E.164 format, e.g. +233241234567
  contactEmail    String // separate from User.email (login email) — the "Contact Email Address" field
  city            String
  address         String
  maritalStatus   MaritalStatus
  occupation      String?

  completedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("MemberProfiles")
}

model RefreshToken {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  deviceInfo String?
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@map("RefreshTokens")
}

model ChurchMembership {
  id       String     @id @default(uuid())
  userId   String
  user     User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  churchId String
  church   Church     @relation(fields: [churchId], references: [id], onDelete: Cascade)
  role     ChurchRole @default(MEMBER)

  status          MembershipStatus @default(PENDING) // PENDING | APPROVED | REJECTED — matches the "Pending Approval" onboarding flow
  rejectionReason String? // set when an admin rejects a join request
  joinedAt        DateTime        @default(now()) // also serves as the join-request submission timestamp

  // Manual admin ban: a user banned from a church can no longer submit join requests.
  isBanned  Boolean   @default(false)
  bannedAt  DateTime?
  banReason String?

  @@unique([userId, churchId]) // a user can't join the same church twice
  @@index([churchId, status]) // admin Join Requests list: requests for a church filtered by status
  @@index([churchId, isBanned]) // admin "banned users" list for a church
  @@map("ChurchMemberships")
}

model Church {
  id               String           @id @default(uuid())
  name             String
  denomination     String // free text — accepts preset or custom value identically
  congregationSize CongregationSize
  foundedYear      Int?

  country         String
  city            String
  address         String
  phone           String // E.164, e.g. +233241234567
  email           String
  primaryLanguage ChurchLanguage
  timeZone        String // IANA tz string, e.g. "Africa/Accra"

  logoUrl String? // R2 object URL

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships  ChurchMembership[]
  serviceTimes ServiceTime[]
  ministries   ChurchMinistry[]

  @@map("Churches")
}

model ServiceTime {
  id        String   @id @default(uuid())
  churchId  String
  church    Church   @relation(fields: [churchId], references: [id], onDelete: Cascade)
  label     String // "Sunday Service", "Midweek Service"
  dayOfWeek Int // 0 (Sunday) – 6 (Saturday)
  time      String // "HH:MM" 24h format — timezone context comes from Church.timeZone
  createdAt DateTime @default(now())

  @@index([churchId])
  @@map("ServiceTimes")
}

model ChurchMinistry {
  id          String  @id @default(uuid())
  churchId    String
  church      Church  @relation(fields: [churchId], references: [id], onDelete: Cascade)
  name        String
  type        String // "MINISTRY" | "DEPARTMENT"
  description String?
  icon        String?
  isCustom    Boolean @default(false)
  isActive    Boolean @default(true)

  @@unique([churchId, name]) // case-sensitive uniqueness per church; case-insensitive enforced at the app layer
  @@map("ChurchMinistries")
}

model Transaction {
  id               String   @id @default(uuid())
  userId           String
  reference        String   @unique
  amount           Decimal
  status           String
  authorizationUrl String
  createdAt        DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([reference])
  @@map("Transactions")
}

model ChurchRequest {
  id           String   @id @default(uuid())
  churchName   String
  city         String
  leaderName   String
  phoneContact String?
  emailContact String?
  requestedById String
  requestedBy  User     @relation(fields: [requestedById], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())

  @@index([requestedById])
  @@map("ChurchRequests")
}
